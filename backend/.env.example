# Copy this file to .env and fill in your values

# --- Database ---
# For quick start (zero-config), leave DB_URL empty to use local SQLite.
# For MySQL, use: mysql+pymysql://user:password@localhost:3306/agripredic
DB_URL=

# --- Auth ---
SECRET_KEY=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Weather (Open-Meteo needs no key, but you can swap in OpenWeatherMap) ---
OPENWEATHER_API_KEY=

# --- Market Prices (Agmarknet via data.gov.in) ---
# Free key: https://data.gov.in/user/register -> My Account -> API Key
DATA_GOV_API_KEY=

# --- WhatsApp / SMS alerts (Twilio) ---
# Free trial account: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# --- Email notifications (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@agripredic.com
ADMIN_PASSWORD=Admin@123
